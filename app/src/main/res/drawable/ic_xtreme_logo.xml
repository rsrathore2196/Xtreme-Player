                <item android:offset="1.0" android:color="#0284C7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Right Arm of the X (/) -->
    <path
        android:pathData="M51,51 L68,27 L78,27 L61,51 Z">
