    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Glow behind the logo -->
    <path
        android:pathData="M52,54m-28,0a28,28 0 1,1 56,0a28,28 0 1,1 -56,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="52"
                android:centerY="54"
                android:gradientRadius="28"
                android:type="radial">
                <item android:offset="0.0" android:color="#5938BDF8" />
                <item android:offset="0.7" android:color="#1A00E5FF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Left Chevron Ribbon (<) -->
    <path
        android:pathData="M27,27 L37,27 L50,54 L37,81 L27,81 L40,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="27"
                android:startY="27"
                android:endX="50"
                android:endY="81"
                android:type="linear">
                <item android:offset="0.0" android:color="#7DD3FC" />
                <item android:offset="0.5" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#0284C7" />
            </gradient>
        </aapt:attr>
    </path>

