    </path>

    <path
        android:pathData="M78,37 A24,24 0 0,1 78,71"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="78"
                android:startY="37"
                android:endX="85"
                android:endY="54"
