    <!-- Center 3D Play Button Triangle (▶) -->
    <path
        android:pathData="M42,39 L65,54 L42,69 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="39"
                android:endX="65"
